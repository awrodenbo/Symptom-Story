# Public client configuration. Never put the service-role key in an Expo app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Add this exact URL to Supabase Auth > URL Configuration > Redirect URLs.
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=symptomstory://reset-password
