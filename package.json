{
  "name": "symptom-story",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20 <25" },
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "preview": "EXPO_PUBLIC_PREVIEW_MODE=true expo start",
    "preview:web": "EXPO_PUBLIC_PREVIEW_MODE=true expo start --web",
    "preview:mobile": "EXPO_PUBLIC_PREVIEW_MODE=true expo start --go",
    "lint": "node scripts/check-language.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.*",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/core.ts --test-coverage-include=src/memoryRepository.ts --test-coverage-include=src/yourStory.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.*",
    "build:web": "expo export --platform web",
    "build:preview": "EXPO_PUBLIC_PREVIEW_MODE=true expo export --platform web",
    "preview:serve": "python3 -m http.server 4174 --directory dist",
    "vercel-build": "npm run build:preview",
    "marketing": "python3 -m http.server 4173 --directory marketing"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.20",
    "expo-blur": "~15.0.7",
    "expo-font": "~14.0.9",
    "expo-linear-gradient": "~15.0.7",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
